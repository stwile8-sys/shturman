<?xml version="1.0" encoding="utf-8"?>
<!-- Только защищённые соединения и только системные сертификаты: защита от подмены трафика (MITM) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
